PORT=5001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-project.vercel.app
# Judge0 Community Edition / self-hosted API base URL (no trailing slash)
JUDGE0_URL=
# Optional: only if your Judge0 provider requires RapidAPI authentication
JUDGE0_API_KEY=
JUDGE0_API_HOST=
# Optional: for self-hosted Judge0 instances using X-Auth-Token
JUDGE0_AUTH_TOKEN=
